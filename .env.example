# Copy this file to .env and fill in your real business details.
# Vite only exposes variables prefixed with VITE_ to the client.

# WhatsApp number in international format, digits only (no +, no leading 0)
# Example for an Indonesian number 0812-3456-7890 -> 6281234567890
VITE_WA_NUMBER=6281234567890

# DANA number shown in the payment info section (display format is fine)
VITE_DANA_NUMBER=0812-3456-7890
VITE_DANA_NAME="Dapur Nenek Rajib"

VITE_BUSINESS_NAME="Dapur Nenek Rajib"
VITE_BUSINESS_ADDRESS="Jl. Contoh No. 123, Bogor, Jawa Barat"
VITE_BUSINESS_HOURS="Setiap hari, 09.00 - 20.00"
VITE_BUSINESS_INSTAGRAM="@dapurnenekrajib"
